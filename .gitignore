# --- Site-specific. Never commit. ------------------------------------------
# The real host registry: machine names, addresses, home paths, allowlists.
# It lives at ~/.config/herdr-spawn/config.toml; this catches a local copy too.
config.toml
service.env
*.env
!*.env.example
.env
.env.*
!.env.example
*.local
*.local.*
secrets/
*.pem
*.key
id_*
known_hosts
web-token
*.token

# --- Runtime state ----------------------------------------------------------
spawns.jsonl
.herdr-handoff/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
