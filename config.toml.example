# herdr-spawn — host registry.
#
# Copy to ~/.config/herdr-spawn/config.toml and edit. That file is the ONLY place
# your machine names, addresses and paths live; it is deliberately outside the
# repo and gitignored.
#
# Every [hosts.<name>] table becomes a value of the tool's `host` parameter, so
# name them the way you'd say them out loud.

[service]
state_dir = "~/.local/state/herdr-spawn"
# Your own map of what work goes in which folder, served to clients as MCP
# instructions at the start of a session. Defaults to instructions.md beside this
# file when that exists. Keep it short: every session that connects reads it.
# instructions_file = "~/.config/herdr-spawn/instructions.md"


# ---------------------------------------------------------------------------
# A local host — the machine this service itself runs on. herdr is reached over
# its own unix socket, so there is no network hop and no credentials.
# ---------------------------------------------------------------------------
[hosts.local]
enabled = true
transport = "socket"
socket_path = "/home/you/.config/herdr/herdr.sock"
# Never a bare "herdr": a systemd --user unit's PATH has no ~/.local/bin, and with
# herdr unresolved the CLI silently falls back to /tmp/herdr/herdr.sock and reports
# `server_not_running` — which blames the wrong thing entirely.
herdr_bin = "/home/you/.local/bin/herdr"
home = "/home/you"
# Both default to <home>/.claude/sessions and <home>/.claude.json. Set them only
# if yours are somewhere else.
# claude_sessions_dir = "/home/you/.claude/sessions"
# claude_config       = "/home/you/.claude.json"

# Where a spawn lands unless the caller asks otherwise. "hc" is herdr-core: the
# session shows in the Herdr app and its mobile client, in the space of the folder
# it works in. "herdr" is a pane in the herdr terminal TUI.
ui = "hc"
# hc_bin = "/home/you/.local/bin/hc"
# A spawn joins the space of its top folder: the first path component below one of
# these. Default is the home, so ~/code/x lands in `code`.
# space_roots = ["/home/you"]

# herdr TUI only: spawned tabs land in a workspace with this label, created on
# first use.
inbox_label = "inbox"

# Which coding agents this host can run is NOT declared here -- it is discovered at
# startup by asking herdr what kinds it supports and checking which are on PATH.
# Install one and restart the service; nothing to edit.

# THE blast-radius control. A spawn's cwd must resolve under one of these roots.
# Keep it to a sandbox you would not mind an unattended agent working in.
cwd_allowlist = ["/home/you/scratch"]

# Obsidian vaults on this host. A caller that knows a note only by its path inside
# the vault can then pass cwd = "notes/projects/plan.md": it resolves under the
# vault root (and to the note's folder), and must still pass cwd_allowlist. The
# vault names are served to clients in the MCP instructions.
# vaults = { notes = "/home/you/notes" }

# Where a spawn lands when the caller names no cwd — so a caller that doesn't
# know your layout doesn't have to guess. Must itself be under cwd_allowlist.
# Never a broad home or a repo root: a default is only as safe as what it points at.
default_cwd = "/home/you/scratch"

# Folders the folder browser (list_folders, the web UI) never lists or descends
# into, even under cwd_allowlist -- for trees whose folder names are private.
# Browsing only: it does not narrow where a spawn may run.
# list_deny = ["/home/you/notes/clients"]

# Never closed, never spawned into. Second belt behind the state-file guard.
protected_workspaces = ["w1", "w2"]

# Per-host only, never a tool parameter. An unattended agent with permissions
# skipped, started from a chat message, is the one combination that can quietly
# do real damage.
skip_permissions = false
sandbox = false


# ---------------------------------------------------------------------------
# A remote host, driven over ssh. `ssh_target` must be something your ssh config
# already resolves and authenticates non-interactively — test it first:
#
#     ssh -o BatchMode=yes <ssh_target> /path/to/herdr workspace list
#
# If that does not print JSON, herdr-spawn cannot use the host either.
# ---------------------------------------------------------------------------
[hosts.laptop]
enabled = false
transport = "ssh"
ssh_target = "you@laptop.example"          # or a Host alias from ~/.ssh/config
# ssh_identity = "/home/you/.ssh/id_ed25519"   # omit to use your ssh config
herdr_bin = "/opt/homebrew/bin/herdr"      # the binary ON THE REMOTE host
home = "/Users/you"                        # the REMOTE home
cwd_allowlist = ["/Users/you/scratch"]
default_cwd = "/Users/you/scratch"
inbox_label = "inbox"

# To follow this host's spawns in the Herdr app too, add it as an hc machine
# (`hc machine add`) and name it here; without it, spawns there use the TUI.
# hc_machine = "laptop"

# Shown verbatim when a caller targets a disabled host. Say what is missing, so
# the refusal is actionable rather than a dead end.
# unavailable_reason = "ssh works but `agent start --kind claude` has never been proven here"


# ---------------------------------------------------------------------------
# A host with no herdr TUI at all, driven only through herdr-core. It must be an
# hc machine on the box this service runs on:
#
#     hc machine ls        # must list it as connected
#
# `home` is the REMOTE user's home. With space_roots = ["/var/www"], a spawn
# anywhere inside a site lands in that site's space.
# ---------------------------------------------------------------------------
[hosts.web]
enabled = false
transport = "hc"
hc_machine = "web"
home = "/root"
cwd_allowlist = ["/var/www/staging.example.com"]
space_roots = ["/var/www"]
# Name the binary when a bare `claude` finds the wrong one there: a stale copy
# earlier on the PATH may not report its status, and `wait` then never returns.
# agent_bin = { claude = "/root/.local/bin/claude" }
