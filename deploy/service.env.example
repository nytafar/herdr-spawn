# Site-specific service settings.
#
#     cp deploy/service.env.example ~/.config/herdr-spawn/service.env
#
# Read by the systemd unit via EnvironmentFile, so it lives outside the repo and
# is gitignored. systemd parses this itself: bare KEY=VALUE, no `export`, no shell.

# Port to listen on.
HERDR_SPAWN_PORT=8230

# Bind address. If you set this, it is used verbatim and no discovery happens.
# NEVER 0.0.0.0 — this tool starts autonomous coding agents, and anything that can
# reach the port can start one.
# HERDR_SPAWN_BIND=127.0.0.1

# Behind a Docker-hosted MCP gateway: name the gateway's compose network and the
# launcher binds that network's bridge IP, reachable from the gateway containers
# and from nothing else. Find it with `docker network ls`.
HERDR_SPAWN_DOCKER_NETWORK=mcp-gateway-registry_default

# stdio | streamable-http
HERDR_SPAWN_TRANSPORT=streamable-http

# Override the config file location (default ~/.config/herdr-spawn/config.toml).
# HERDR_SPAWN_CONFIG=/home/you/.config/herdr-spawn/config.toml

# DEBUG for per-request detail.
# HERDR_SPAWN_LOG=INFO
